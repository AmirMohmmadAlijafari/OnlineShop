@model List<OnlineShop.Models.Order>

@{
    ViewData["Title"] = "مدیریت سفارش‌ها";
}

<h2 class="mb-4">مدیریت سفارش‌ها</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        هیچ سفارشی ثبت نشده است.
    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">
            <tr>
                <th>شماره سفارش</th>
                <th>نام مشتری</th>
                <th>تاریخ سفارش</th>
                <th>مبلغ کل</th>
                <th>وضعیت</th>
                <th>جزئیات</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Id
                    </td>

                    <td>
                        @item.CustomerName
                    </td>

                    <td>
                        @item.OrderDate.ToString("yyyy/MM/dd HH:mm")
                    </td>

                    <td>
                        @item.TotalAmount.ToString("N0") تومان
                    </td>

                    <td>
                        <span class="badge bg-success">
                            @item.Status
                        </span>
                    </td>

                    <td>

                        <a asp-controller="Orders"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           asp-route-returnUrl="@Url.Action("Index", "Orders")"
                           class="btn btn-outline-primary btn-sm">
                            مشاهده
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}