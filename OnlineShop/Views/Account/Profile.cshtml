@model OnlineShop.Models.ApplicationUser

@{
    ViewData["Title"] = "پروفایل کاربر";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">

            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">پروفایل کاربر</h3>
            </div>

            <div class="card-body">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-bold">نام و نام خانوادگی</label>
                    <input class="form-control" value="@Model.FullName" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">نام کاربری</label>
                    <input class="form-control" value="@Model.UserName" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">ایمیل</label>
                    <input class="form-control" value="@Model.Email" readonly />
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">

                    <a asp-action="EditProfile" class="btn btn-warning">
                        ویرایش پروفایل
                    </a>

                    <a asp-action="ChangePassword" class="btn btn-danger">
                        تغییر رمز عبور
                    </a>

                    <a asp-controller="Orders"
                       asp-action="MyOrders"
                       class="btn btn-success">
                        سفارش‌های من
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-secondary">
                        بازگشت
                    </a>

                </div>

            </div>

        </div>
    </div>

</div>