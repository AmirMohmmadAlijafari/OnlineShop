<!DOCTYPE html>

<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineShop</title>

    <link rel="stylesheet" href="~/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                OnlineShop
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto gap-3">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Products" asp-action="Index">
                            مشاهده لیست محصولات
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cart" asp-action="Index">
                            سبد خرید
                        </a>
                    </li>

                </ul>

                <ul class="navbar-nav gap-3">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                پروفایل من
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Orders" asp-action="MyOrders">
                                سفارش‌های من
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="Index">
                                    مدیریت سفارش‌ها
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-warning" asp-controller="Account" asp-action="Logout">
                                خروج
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">
                                ثبت نام
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                ورود
                            </a>
                        </li>
                    }

                </ul>

            </div>

        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


</body>
</html>