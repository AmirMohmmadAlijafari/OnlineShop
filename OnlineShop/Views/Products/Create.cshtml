@model OnlineShop.Models.Product

@{
    ViewData["Title"] = "افزودن محصول";
}

<h2 class="mb-4">افزودن محصول جدید</h2>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">
                    نام محصول
                </label>

                <input asp-for="Name" class="form-control" />

                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    توضیحات
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">
                    قیمت
                </label>

                <input asp-for="Price" class="form-control" />

                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Stock" class="form-label">
                    موجودی
                </label>

                <input asp-for="Stock" class="form-control" />

                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">
                    دسته بندی
                </label>

                <select asp-for="CategoryId"
                        asp-items="ViewBag.Categories"
                        class="form-select">

                    <option value="">انتخاب دسته بندی</option>

                </select>

                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">

                <label asp-for="ImageFile" class="form-label">
                    تصویر محصول
                </label>

                <input asp-for="ImageFile"
                       type="file"
                       class="form-control" />

                <span asp-validation-for="ImageFile"
                      class="text-danger"></span>

            </div>

            <button type="submit" class="btn btn-success">
                ثبت محصول
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                بازگشت
            </a>

        </form>

    </div>
</div>

