@model List<OnlineShop.Models.Product>

@{
    ViewData["Title"] = "محصولات دسته‌بندی";
}

<h2 class="mb-4">محصولات دسته‌بندی</h2>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl"
                         class="card-img-top"
                         style="height:220px;object-fit:cover;" />
                }

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title text-center">
                        @item.Name
                    </h5>

                    <p class="card-text text-center text-success fw-bold">
                        @item.Price.ToString("N0") تومان
                    </p>

                    <div class="mt-auto d-grid gap-2">

                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           asp-route-returnUrl="@Url.Action("ByCategory", "Products", new { id = item.CategoryId })"
                           class="btn btn-outline-primary">
                            مشاهده جزئیات
                        </a>

                        @if (item.Stock > 0)
                        {
                            <form asp-controller="Cart"
                                  asp-action="AddToCart"
                                  method="post">

                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="returnUrl"
                                       value="@Url.Action("ByCategory", "Products", new { id = item.CategoryId })" />

                                <button type="submit" class="btn btn-primary w-100">
                                    افزودن به سبد خرید
                                </button>

                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100" disabled>
                                ناموجود
                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>

    }

</div>

<a asp-controller="Home"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    بازگشت به صفحه دسته‌بندی
</a>