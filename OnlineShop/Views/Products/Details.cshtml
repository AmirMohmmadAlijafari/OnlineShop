@model OnlineShop.Models.Product

@{
    ViewData["Title"] = "جزئیات محصول";

    var returnUrl = Context.Request.Query["returnUrl"].ToString();

    if (string.IsNullOrEmpty(returnUrl))
    {
        returnUrl = Url.Action("Index", "Products");
    }

}

<h2 class="mb-4">جزئیات محصول</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">

            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         class="img-fluid rounded"
                         style="max-height:300px;object-fit:contain;" />
                }
                else
                {
                    <div class="text-muted">بدون تصویر</div>
                }
            </div>

            <div class="col-md-8">
                <h3 class="mb-3">@Model.Name</h3>

                <p>
                    <strong>دسته‌بندی:</strong>
                    @Model.Category?.Name
                </p>

                <p>
                    <strong>قیمت:</strong>
                    @Model.Price.ToString("N0") تومان
                </p>

                <p>
                    <strong>موجودی:</strong>
                    @if (Model.Stock > 0)
                    {
                        @Model.Stock
                    }
                    else
                    {
                        <span class="text-danger fw-bold">ناموجود</span>
                    }
                </p>

                <p>
                    <strong>توضیحات:</strong>
                </p>

                <p class="text-muted">
                    @Model.Description
                </p>

                <hr />

                <div class="d-flex flex-wrap gap-2">

                    @if (Model.Stock > 0)
                    {
                        <form asp-controller="Cart"
                              asp-action="AddToCart"
                              method="post"
                              class="d-inline">

                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />

                            <button type="submit" class="btn btn-success">
                                افزودن به سبد خرید
                            </button>

                        </form>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">
                            ویرایش
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-danger">
                            حذف
                        </a>
                    }

                    <a href="@returnUrl" class="btn btn-secondary">
                        بازگشت
                    </a>

                </div>

            </div>

        </div>
    </div>

</div>