@model IEnumerable<OnlineShop.Models.Product>

<h2>محصولات</h2>

<table class="table table-bordered">

    <tr>

        <th>نام</th>

        <th>قیمت</th>

        <th>موجودی</th>

        <th>دسته بندی</th>

    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Name</td>

            <td>@item.Price.ToString("N0") تومان</td>

            <td>@item.Stock</td>

            <td>@item.Category.Name</td>

        </tr>
    }

</table>